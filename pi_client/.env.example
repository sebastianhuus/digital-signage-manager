# Pi Client Environment Variables
# Copy this file to .env on your Raspberry Pi and update the values

# Your Signage Manager URL (required)
SIGNAGE_API_URL=https://your-app.vercel.app

# API key from your signage manager (required)
SIGNAGE_API_KEY=signage-api-key-2025

# Unique screen ID for this Pi (required)
SIGNAGE_SCREEN_ID=tv-1

# Optional: Polling intervals in seconds (active hours)
SIGNAGE_POLL_INTERVAL=30
SIGNAGE_HEARTBEAT_INTERVAL=60

# Optional: Polling intervals during inactive hours (default: 300s / 5 min)
SIGNAGE_INACTIVE_POLL_INTERVAL=300
SIGNAGE_INACTIVE_HEARTBEAT_INTERVAL=300

# Optional: Active hours window (24h format, uses Pi local time)
SIGNAGE_ACTIVE_START=07:00
SIGNAGE_ACTIVE_END=22:00
