# Signage Manager Environment Variables
# Copy this file to .env.local and fill in your values

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin login password for the web UI (required)
SIGNAGE_PASSWORD=your-secure-password

# Secret key to protect the /api/setup and /api/migrate endpoints (required)
SETUP_KEY=your-setup-key

# Optional: app version displayed in the UI (defaults to 0.1.0)
# NEXT_PUBLIC_APP_VERSION=0.1.0
